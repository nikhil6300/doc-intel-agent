# Copy to .env and edit. Defaults run fully offline (no keys needed).

# --- Providers: "hash"/"extractive" are offline stand-ins; switch to "openai" for real quality ---
EMBEDDING_PROVIDER=hash
LLM_PROVIDER=extractive

# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://your-litellm-gateway/v1   # any OpenAI-compatible endpoint
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODEL=gpt-4o-mini

# --- Retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4
MIN_SCORE=0.0

# --- Security: when set, clients must send header  X-API-Key: <value> ---
# API_KEY=change-me
